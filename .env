# Committed, non-secret dev defaults. Host-specific overrides go to .env.local (git-ignored).

# PostgreSQL (dev stack)
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger

# anvil (local EVM node), reached through the shared Traefik proxy
ANVIL_CHAIN_ID=31337
ETH_RPC_URL=http://anvil.stablecoin-ledger.localhost

# Seals webhook signing secrets at rest (64 hex characters). Dev/test value only — production
# injects its own from a secret store.
WEBHOOK_SECRET_KEY=de0de0de0de0de0de0de0de0de0de0de0de0de0de0de0de0de0de0de0de0de0d
