# Required environment keys. Copy to .env.local to override the committed defaults in .env.

# PostgreSQL
DATABASE_URL=postgres://ledger:change-me@localhost:5432/ledger

# Webhooks: key that encrypts signing secrets at rest, 64 hex characters (`openssl rand -hex 32`)
WEBHOOK_SECRET_KEY=
# true lets webhooks reach private, loopback and link-local receivers; development only (default false)
WEBHOOK_ALLOW_PRIVATE_URLS=false

# Holds: how often overdue holds are expired, in seconds (default 30)
HOLD_EXPIRY_INTERVAL_SECONDS=30

