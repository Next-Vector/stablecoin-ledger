# Required environment keys. Copy to .env.local to override the committed defaults in .env.

# PostgreSQL
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ledger
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://ledger:change-me@localhost:5432/ledger

# Webhooks: key that encrypts signing secrets at rest, 64 hex characters (`openssl rand -hex 32`)
WEBHOOK_SECRET_KEY=

# EVM node
ANVIL_CHAIN_ID=31337
ETH_RPC_URL=http://anvil.stablecoin-ledger.localhost
