#!/bin/sh
# Commit message rules (CLAUDE.md):
#   subject  type(scope): summary (#N)   — conventional type, optional scope, issue reference, ≤ 100 chars
#   body     at most one short paragraph
#   no Co-Authored-By / AI attribution trailer
# Merge, revert, fixup! and squash! messages pass unchanged.

msg_file=$1
# Drop git comment lines and trailing blank lines.
message=$(grep -v '^#' "$msg_file" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}')
subject=$(printf '%s\n' "$message" | head -n 1)

fail() {
  echo "commit-msg: $1" >&2
  echo "commit-msg: subject was: $subject" >&2
  exit 1
}

case "$subject" in
  "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

types='feat|fix|chore|docs|ci|test|refactor|perf|build|style|revert'
printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-z0-9-]+\))?!?: [^ ].* \(#[0-9]+\)$" ||
  fail "subject must be 'type(scope): summary (#N)' with type one of ${types}"

[ "${#subject}" -le 100 ] || fail "subject is ${#subject} characters long, the maximum is 100"

printf '%s\n' "$message" | grep -Eqi '^co-authored-by:' &&
  fail "Co-Authored-By trailers are not allowed"

paragraphs=$(printf '%s\n' "$message" | tail -n +2 | awk 'NF && !inpara { n++; inpara = 1 } !NF { inpara = 0 } END { print n + 0 }')
[ "$paragraphs" -le 1 ] || fail "the body may have at most one paragraph, found $paragraphs"

exit 0
